{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "learning-desktop",
  "description": "仅打包的主学习窗口可逐次选择学习 JSON 或 PDF/图片；资料正文须明确确认后读取。通过受限系统浏览器完成授权，不开放任意路径或命令。",
  "windows": ["main"],
  "local": true,
  "platforms": ["macOS", "windows"],
  "permissions": [
    "allow-voice-capability",
    "allow-voice-start",
    "allow-voice-stop",
    "allow-voice-cancel",
    "allow-choose-learning-save",
    "allow-share-learning-poster",
    "allow-write-learning-selection",
    "allow-discard-learning-selection",
    "allow-read-learning-backup",
    "allow-choose-learning-material",
    "allow-read-learning-material",
    "allow-discard-learning-material",
    "allow-create-desktop-oauth-proof",
    "allow-open-desktop-oauth",
    "allow-open-support-feedback",
    "allow-focus-desktop-after-oauth",
    "allow-begin-learning-notifications",
    "allow-learning-notification-permission",
    "allow-replace-learning-notifications",
    "allow-take-learning-notification-actions",
    "allow-test-learning-notification",
    "allow-open-learning-notification-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-open-desktop-settings",
    "allow-complete-desktop-model-intake",
    "allow-set-desktop-appearance",
    "allow-complete-settings-notification-refresh",
    "core:window:allow-start-dragging"
  ]
}
